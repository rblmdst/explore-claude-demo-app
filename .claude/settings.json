{
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Read(./*.env)"
    ]
  },
  "extraKnownMarketplaces": {
    "explore-demo": {
      "source": {
        "source": "github",
        "repo": "rblmdst/explore-claude-demo-app"
      }
    }
  },
  "enabledPlugins": {
    "express-3tiers@explore-demo": true
  }
}
